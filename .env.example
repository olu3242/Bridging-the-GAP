# Supabase project (Project Settings → API)
#
# These three must carry the NEXT_PUBLIC_ prefix exactly. Next.js inlines only
# NEXT_PUBLIC_* into the browser bundle at build time, so a value stored under
# another name (NEXT_SUPABASE_URL, NEXT_SITE_URL, …) can never reach the client
# — the app deliberately refuses to read those rather than half-work.
#
# A variable that exists with an EMPTY value is treated as unset. On a hosting
# dashboard an empty value looks the same as a filled one, and it is the most
# common way this breaks. Because NEXT_PUBLIC_* is baked into the build, editing
# any of these requires a REDEPLOY, not just a restart.
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<publishable-anon-key>

# Absolute origin used for auth email + OAuth redirects. On Vercel previews the
# request's own forwarded host wins over this, so one value covers production.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Local schema/RLS certification (scripts/local-db.sh prints this)
BTG_TEST_DATABASE_URL=postgresql://postgres@127.0.0.1:55432/btg_test

# Optional — browser E2E only. A Google test account that can clear the consent
# screen, so tests/e2e/auth-journey.spec.ts can certify Google end to end.
# BTG_E2E_GOOGLE_EMAIL=
# BTG_E2E_GOOGLE_PASSWORD=
